# Copy to backend/.env and adjust. Loaded via pydantic-settings.
# Async driver (asyncpg). Same creds work for local native Postgres and docker-compose.
DATABASE_URL=postgresql+asyncpg://rot_royale:rot_royale@localhost:5432/rot_royale

# Separate database the test suite runs against (created once: CREATE DATABASE rot_royale_test).
# Keeps tests isolated from the live DB the settlement daemon writes to.
TEST_DATABASE_URL=postgresql+asyncpg://rot_royale:rot_royale@localhost:5432/rot_royale_test

# Comma-separated WEB origins allowed to call the API in dev (Vite default is 5173). Any localhost
# port is also allowed in non-production via a regex. The native iOS/Android app origin
# (capacitor://localhost) is ALWAYS allowed in code (NATIVE_APP_ORIGINS, app/core/config.py) — never
# put it here.
CORS_ORIGINS=http://localhost:5173

# App environment: local | staging | production
APP_ENV=local

# Admin email allowlist (comma-separated) for content-ops / admin routes (e.g. the estimate
# playtest-verdict endpoints). Layered on normal JWT auth via app/api/deps.get_admin_user. Empty =
# no admins. These accounts must still register/log in normally; membership only grants admin routes.
# Admin allowlist — comma-separated USER IDs (UUIDs), not emails. Empty = no admins (fails closed).
# Ids, because this product has no email verification and registration is open: an allowlisted
# EMAIL that nobody had registered yet was claimable by whoever signed up with it first. Find an id
# with: select id from users where email = '...';
ADMIN_USER_IDS=

# JWT signing secret — MUST be overridden in every non-local environment (>=32 bytes for HS256).
SECRET_KEY=dev-insecure-secret-change-me-in-production-0000
ACCESS_TOKEN_TTL_MINUTES=30
REFRESH_TOKEN_TTL_DAYS=30

# Background scheduler daemon. Local dev runs it in-process (true). In production it is run as a
# Render Cron job instead (see render.yaml) so it executes exactly once — set this to false on the
# web service there.
SCHEDULER_ENABLED=true
SCHEDULER_TICK_SECONDS=60

# Web Push / VAPID (M9). Push is sent only when BOTH keys are set; otherwise the notify hook is a
# no-op (safe for local dev). Generate a stable pair ONCE (rotating them invalidates every existing
# browser subscription) with:
#   uv run python -c "from py_vapid import Vapid01; from cryptography.hazmat.primitives import serialization as s; import base64; b=lambda x: base64.urlsafe_b64encode(x).rstrip(b'=').decode(); v=Vapid01(); v.generate_keys(); print('VAPID_PRIVATE_KEY='+b(v.private_key.private_numbers().private_value.to_bytes(32,'big'))); print('VAPID_PUBLIC_KEY='+b(v.public_key.public_bytes(s.Encoding.X962, s.PublicFormat.UncompressedPoint)))"
# VAPID_PUBLIC_KEY  = base64url uncompressed point (~87 chars) — the browser applicationServerKey.
# VAPID_PRIVATE_KEY = base64url raw 32-byte private key (~43 chars) — server only, NEVER commit.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@rotroyale.example

# iOS native push (APNs, token-based auth). Native push is sent only when ALL FOUR are set; else the
# native leg is skipped (web-push still works). From the Apple Developer portal → Keys, create an
# APNs Auth Key (.p8), then set:
#   APNS_KEY_P8  = the FULL contents of AuthKey_XXXXXX.p8 (paste the PEM, keep the BEGIN/END lines)
#   APNS_KEY_ID  = the 10-char Key ID of that .p8
#   APNS_TEAM_ID = your 10-char Apple Team ID
#   APNS_TOPIC   = the app Bundle ID (e.g. com.rotroyale.app) — must match the iOS build
#   APNS_USE_SANDBOX = true for development/TestFlight-debug builds, false for App Store/production
# The iOS app also needs the "Push Notifications" capability + an aps-environment entitlement.
APNS_KEY_P8=
APNS_KEY_ID=
APNS_TEAM_ID=
APNS_TOPIC=
APNS_USE_SANDBOX=false
# ET hour (0–23) the evening "play before midnight / your streak ends tonight" nudge fires.
PUSH_REMINDER_HOUR_ET=20

# ── AI question classification (LLM) ──────────────────────────────────────
# Batch/CLI only (`uv run python -m app.jobs.run classify …`) — the LLM is NEVER called during
# gameplay. With ROT_AI_ENABLED=false or any credential blank, the app runs normally and the
# classify job exits with a clear message.
#
# >>> PUT YOUR REAL API KEY HERE (in backend/.env, which is gitignored — never commit it): <<<
#   ROT_AI_API_KEY   your provider key
#   ROT_AI_BASE_URL  OpenAI-compatible base URL, e.g. https://api.openai.com/v1
#   ROT_AI_MODEL     model id, e.g. gpt-4o-mini
ROT_AI_ENABLED=false
ROT_AI_PROVIDER=openai_compatible
ROT_AI_API_KEY=
ROT_AI_BASE_URL=
ROT_AI_MODEL=
ROT_AI_CLASSIFICATION_TEMPERATURE=0
ROT_AI_CLASSIFICATION_TIMEOUT_MS=30000
ROT_AI_BATCH_SIZE=25
ROT_AI_MAX_RETRIES=2

# ── Silent personalization ─────────────────────────────────────────────────
# Taste profiles + question ranking for no-stakes modes (practice/quick/category).
# PERSONALIZE_RANKED_DAILY must stay false unless you accept per-user ranked pools (leaderboard
# fairness). PERSONALIZATION_DEBUG additionally exposes GET /personalization/me/profile in prod.
PERSONALIZATION_ENABLED=true
PERSONALIZE_RANKED_DAILY=false
PERSONALIZATION_DEBUG=false

# ---------------------------------------------------------------------------
# Production (Render) — set these on the web service + cron job. NEVER commit real values.
# ---------------------------------------------------------------------------
# DATABASE_URL     Render injects this from the managed Postgres (see render.yaml `fromDatabase`).
#                  A raw Render `postgres://…`/`postgresql://…` string is accepted as-is — the app
#                  upgrades it to the asyncpg driver and strips libpq-only params (e.g. sslmode)
#                  automatically (app/core/config.py). Prefer the INTERNAL connection string.
# SECRET_KEY       Generate a strong random value (Render `generateValue: true` does this). Rotating
#                  it invalidates all issued access/refresh tokens.
# CORS_ORIGINS     The HTTPS WEB origin(s) of the deployed frontend, comma-separated, e.g.
#                  https://rotroyale.live  (custom domain) and/or https://rot-royale-web.onrender.com.
#                  Do NOT leave http://localhost:5173 in the prod value — lock it to the real web
#                  origin(s) only. The native app origin (capacitor://localhost) is ALWAYS allowed in
#                  code, so it does NOT need to be (and should not be) added here.
# APP_ENV          production
# SCHEDULER_ENABLED=false  on the web service (the cron job owns scheduling in prod).
