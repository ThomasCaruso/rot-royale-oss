# Production build environment (COMMITTED — this is a public HTTPS endpoint, not a secret).
#
# Vite bakes VITE_API_BASE into the bundle at build time. `npm run build` runs in "production" mode,
# so this file is loaded and takes precedence over .env / .env.local. That means a local dev override
# (frontend/.env.local → http://localhost:8001) will NOT leak into a production/iOS build.
#
# Without this file, src/api/client.ts falls back to http://localhost:8000, which is broken inside an
# iOS WebView (localhost = the phone itself). This file is what makes the production mobile build call
# the live backend.
#
# Verified live: GET https://rot-royale-api.onrender.com/health -> 200 {"status":"ok","db":"ok"}.
# Must stay in sync with the backend's CORS_ORIGINS allow-list.
VITE_API_BASE=https://rot-royale-api.onrender.com
