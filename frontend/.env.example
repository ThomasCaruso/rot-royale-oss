# Copy to frontend/.env.local. Base URL of the backend API.
# NOTE: the variable is VITE_API_BASE (read in src/api/client.ts). It is baked in at BUILD time by
# Vite, so it must be set before `npm run build` (on Render: a build-time env var on the static site).
VITE_API_BASE=http://localhost:8000

# Production (Render static site) — set to the HTTPS origin of the deployed API, e.g.
#   VITE_API_BASE=https://rot-royale-api.onrender.com
# This must match the value CORS_ORIGINS allows on the backend.

# Dev-only: show the hidden taste-profile inspector (src/screens/dev/PersonalizationDebug.tsx).
# Baked in at build time — leave false/unset for any production build.
VITE_PERSONALIZATION_DEBUG=false
